# XNTsrv GTK 2 theme: the classic Windows colours on GTK's own built-in
# drawing, which is flat colour and simple bevels with no pictures.
#
# colors.rc is generated by xntsrv-appearance from the user's Windows
# colours; this file never changes with them.

include "colors.rc"

gtk-button-images = 0
gtk-menu-images = 0

style "xntsrv-default" {
  bg[NORMAL]        = @bg_color
  bg[PRELIGHT]      = @hover_color
  bg[ACTIVE]        = @pressed_color
  bg[SELECTED]      = @selected_bg_color
  bg[INSENSITIVE]   = @bg_color

  fg[NORMAL]        = @fg_color
  fg[PRELIGHT]      = @fg_color
  fg[ACTIVE]        = @fg_color
  fg[SELECTED]      = @selected_fg_color
  fg[INSENSITIVE]   = @insensitive_fg_color

  base[NORMAL]      = @base_color
  base[PRELIGHT]    = @base_color
  base[ACTIVE]      = @selected_bg_color
  base[SELECTED]    = @selected_bg_color
  base[INSENSITIVE] = @bg_color

  text[NORMAL]      = @text_color
  text[PRELIGHT]    = @text_color
  text[ACTIVE]      = @selected_fg_color
  text[SELECTED]    = @selected_fg_color
  text[INSENSITIVE] = @insensitive_fg_color

  xthickness = 1
  ythickness = 1

  GtkWidget::link-color         = @link_color
  GtkWidget::visited-link-color = @link_color
  GtkWidget::focus-line-width   = 1
  GtkButton::default-border     = { 0, 0, 0, 0 }
  GtkMenu::horizontal-padding   = 0
  GtkMenu::vertical-padding     = 1
}

style "xntsrv-menu" {
  bg[NORMAL]   = @menu_color
  fg[NORMAL]   = @menu_fg_color
  bg[PRELIGHT] = @selected_bg_color
  fg[PRELIGHT] = @selected_fg_color
  bg[SELECTED] = @selected_bg_color
  fg[SELECTED] = @selected_fg_color
  text[PRELIGHT] = @selected_fg_color
}

style "xntsrv-tooltip" {
  bg[NORMAL] = @tooltip_bg_color
  fg[NORMAL] = @tooltip_fg_color
}

class "GtkWidget" style "xntsrv-default"
widget_class "*<GtkMenuShell>*" style "xntsrv-menu"
widget "gtk-tooltip*" style "xntsrv-tooltip"
